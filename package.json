{
  "name": "scrubplus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sterile, hands-free 3D surgical planning console in the browser.",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "node scripts/build-web.mjs",
    "smoke:prod": "node --experimental-transform-types scripts/smoke-prod.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "bench": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.182.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

---
import { MOMENTS } from '../data/content.ts';
import AssetVideo from './AssetVideo.astro';

const fmt = (v: number | null, digits = 0) => (v === null ? '—' : v.toFixed(digits));
---

<section class="moments" aria-labelledby="moments-label" id="moments">
  <div class="wrap">
    <h2 class="visually-hidden" id="moments-label">Two planning tasks</h2>
  </div>
  {
    MOMENTS.map((m) => (
      <article class="moment" data-moment aria-labelledby={`moment-${m.key}`}>
        <div class="wrap grid">
          <header class="copy">
            <h2 class="h2" id={`moment-${m.key}`}>
              {m.title}
            </h2>
            <p class="body">{m.line}</p>
          </header>
          <div class="screen">
            <AssetVideo
              name={m.asset}
              alt={`Scrub+ running: ${m.line}`}
            />
            <dl class="hud mono" aria-label="Planning numbers">
              {m.hud.map((h) => (
                <div class="cell">
                  <dt class="label">{h.label}</dt>
                  <dd
                    class="num v"
                    data-from={h.from ?? undefined}
                    data-to={h.to ?? undefined}
                    data-digits={h.digits ?? 0}
                  >
                    <span class="n">{fmt(h.from, h.digits)}</span>
                    {h.unit && <span class="u">{h.unit}</span>}
                  </dd>
                  {h.from !== null && h.to !== null && (
                    <dd class="label delta">
                      {fmt(h.from, h.digits)} → {fmt(h.to, h.digits)}
                    </dd>
                  )}
                </div>
              ))}
              {m.verdicts.length > 0 && (
                <div class="cell verdicts">
                  <dt class="label">Verdict</dt>
                  {m.verdicts.map((v, j) => (
                    <dd class:list={['verdict', v.tone]} data-verdict={j} data-at={v.at}>
                      {v.text}
                    </dd>
                  ))}
                </div>
              )}
            </dl>
          </div>
        </div>
      </article>
    ))
  }
</section>

<style>
  .moments {
    padding-top: var(--s-20);
  }
  .moment {
    padding-block: var(--s-12);
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .moment .grid {
    row-gap: var(--s-4);
    align-items: end;
  }
  .copy {
    grid-column: 1 / span 4;
    display: grid;
    gap: var(--s-3);
    align-self: center;
  }
  .screen {
    grid-column: 5 / span 8;
    display: grid;
    gap: var(--s-2);
  }
  .hud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    border-top: var(--hair);
    padding-top: var(--s-2);
  }
  .cell {
    display: grid;
    gap: 0.35rem;
    min-width: 8rem;
  }
  .v {
    font-size: var(--fs-44);
  }
  .verdict {
    font-family: var(--font-display);
    font-size: var(--fs-20);
    font-weight: 500;
    line-height: 1.2;
  }
  .verdict.accent {
    color: var(--accent);
  }
  .verdict.danger {
    color: var(--danger);
  }
  /* Scrubbed: only the verdict for the current half of the take is shown. */
  :global(html.motion) .verdicts[data-live] .verdict:not(.on) {
    display: none;
  }
  @media (max-width: 1023px) {
    .copy,
    .screen {
      grid-column: 1 / -1;
    }
    .moment {
      min-height: 0;
    }
  }
</style>

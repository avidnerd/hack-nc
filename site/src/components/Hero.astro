---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

import { LINKS } from '../data/content.ts';

const mobileFile = 'hero-mobile.mp4';
const hasMobile = existsSync(fileURLToPath(new URL(`../../public/video/${mobileFile}`, import.meta.url)));
const demoHref = LINKS.video ?? '#moments';
const appHref = LINKS.app ?? '/demo';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <canvas
    class="canvas"
    data-hero-canvas
    role="img"
    aria-label="Volume rendering of a real abdominal CT. Scrolling sweeps a cutting plane through the right flank, exposing the liver, the tumour in red and a hepatic vessel; moving the pointer slices the torso under the cursor."
  ></canvas>

  {
    hasMobile && (
      <div class="mobile" aria-hidden="true">
        <video src={`/video/${mobileFile}`} muted playsinline loop autoplay preload="metadata" />
      </div>
    )
  }

  <p class="loading label" data-hero-loading aria-live="polite">Loading CT 0%</p>

  <div class="cam" aria-hidden="true">
    <video id="cam" playsinline muted></video>
    <canvas id="camoverlay"></canvas>
  </div>

  <div class="wrap grid copy">
    <div class="text">
      <p class="label">HackNC 2026 · Touchless surgical planning</p>
      <h1 class="display" id="hero-title">Transforming human–computer interaction for surgeons.</h1>
      <p class="sub">Surgical planning on a real CT, by hand and voice.</p>
      <p class="links">
        <a href={appHref}>Try it live <span aria-hidden="true">→</span></a>
        <a href={demoHref}>Watch the 90-second demo</a>
      </p>
    </div>
    <div class="hand">
      <div class="live" data-hero-live hidden aria-live="off">
        <p class="live-hint">Move the pointer to cut.</p>
        <dl class="live-nums">
          <div><dt>Liver kept</dt><dd><span data-v="remnant">100</span><span class="u">%</span></dd></div>
          <div><dt>Margin to tumour</dt><dd><span data-v="margin">—</span><span class="u">mm</span></dd></div>
          <div><dt>Vessels cut</dt><dd><span data-v="vessels">0</span></dd></div>
        </dl>
      </div>
      <button type="button" class="hand-btn" data-hand-button hidden>Use your webcam instead</button>
      <p class="note" data-hand-note aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  import { mountHero } from '../scripts/hero/hero.ts';

  const root = document.querySelector<HTMLElement>('[data-hero]')!;
  // Any device with WebGL2 gets the real renderer; narrow screens just skip
  // the webcam option.
  const gl = !!document.createElement('canvas').getContext('webgl2');
  if (gl) {
    root.dataset.webgl = '';
    void mountHero(root);
  }
</script>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 36rem;
    overflow: hidden;
    /* The signature: the torso lies in the pool of light under an overhead
       surgical lamp. Centred where the renderer draws the body (its view is
       shifted 27 % right), and the only gradient on the page besides the
       falloff into the copy below. */
    background: radial-gradient(ellipse 40% 56% at 75% 44%, var(--lamp) 0%, var(--bg-raise) 48%, var(--bg) 100%);
  }

  .canvas,
  .mobile {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .canvas {
    display: none;
  }
  .hero[data-webgl] .canvas {
    display: block;
  }
  .hero[data-webgl] .mobile {
    display: none;
  }
  .mobile video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--frame);
  }

  /* The render's own falloff into the page is the only gradient on the site:
     it keeps the copy legible where the torso passes behind it. */
  .hero::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 45%;
    background: linear-gradient(to top, var(--bg), transparent);
    pointer-events: none;
  }

  .loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--text-dim);
    margin: 0;
    display: none;
  }
  .hero[data-webgl]:not([data-ready]) .loading {
    display: block;
  }

  .copy {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    padding-bottom: clamp(2rem, 6vh, 4.5rem);
    align-items: end;
  }
  .text {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--s-3);
  }
  /* A sentence, not a slogan: set a step below the display size so it holds
     its lines at laptop heights, clear of the torso. */
  .display {
    font-size: clamp(2.5rem, 1rem + 4.3vw, 4.9rem);
    max-width: 15ch;
  }
  .sub {
    color: var(--text-dim);
    font-size: var(--fs-20);
    max-width: 44ch;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    font-size: var(--fs-16);
    color: var(--text);
  }
  .links a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-short) var(--ease-in);
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }

  .hand {
    grid-column: 9 / span 4;
    justify-self: end;
    text-align: right;
    display: grid;
    gap: var(--s-1);
  }
  .hand-btn {
    justify-self: end;
    font-family: var(--font-display);
    font-size: var(--fs-14);
    color: var(--text);
    padding: 0.7rem 1rem;
    border: var(--hair);
    border-color: var(--text-faint);
    border-radius: var(--radius);
    transition: border-color var(--dur-short) var(--ease-in);
  }
  .hand-btn:hover {
    border-color: var(--text-dim);
  }
  .hand-btn:disabled {
    color: var(--text-faint);
    cursor: progress;
  }
  /* Live planning numbers: the engine's output for whatever plane is on
     screen, so the cut and the numbers can be checked against each other. */
  .live {
    justify-self: stretch;
    display: grid;
    gap: var(--s-2);
    text-align: left;
    margin-bottom: var(--s-3);
    padding-top: var(--s-2);
    border-top: var(--hair);
  }
  .live-hint {
    font-size: var(--fs-14);
    color: var(--text-dim);
  }
  .hero[data-pointer] .live-hint {
    visibility: hidden;
  }
  .live-nums {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: var(--s-1) var(--s-4);
  }
  .live-nums dt {
    font-size: var(--fs-12);
    color: var(--text-faint);
  }
  .live-nums dd {
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-28);
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .live-nums .u {
    font-size: 0.55em;
    color: var(--text-dim);
    margin-left: 0.1em;
  }
  .live[data-state='through'] [data-v='margin'] {
    color: var(--danger);
  }
  .live-src {
    font-size: var(--fs-12);
    color: var(--text-faint);
  }
  .note {
    font-family: var(--font-display);
    font-size: var(--fs-14);
    color: var(--text-faint);
    min-height: 1.4em;
    max-width: 32ch;
  }

  .cam {
    position: absolute;
    top: 5rem;
    right: var(--edge);
    width: 160px;
    aspect-ratio: 4 / 3;
    z-index: 3;
    display: none;
    border: var(--hair);
    background: var(--frame);
  }
  .hero[data-hand] .cam {
    display: block;
  }
  .cam video,
  .cam canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cam video {
    transform: scaleX(-1);
    opacity: 0.55;
  }

  @media (max-width: 1023px) {
    .text {
      grid-column: 1 / -1;
    }
    .hand {
      display: none;
    }
  }
</style>

---
import { AI_TABLE, FORMULAS, NOT_AI } from '../data/content.ts';
---

<section class="section" aria-labelledby="formulas-label" id="formulas">
  <div class="wrap">
    <div class="grid intro">
      <h2 class="h2" id="formulas-label">Where each number comes from</h2>
      <p class="body">
        Planning numbers come from segmentation masks and plain geometry, unit-tested against an independent numpy
        implementation. A plane is n·x = d in millimetres. The resected side is n·x − d &gt; 0.
      </p>
    </div>

    <table class="table mono">
      <caption class="visually-hidden">On-screen numbers and the formulas behind them</caption>
      <thead>
        <tr><th scope="col" class="label">On screen</th><th scope="col" class="label">Formula</th></tr>
      </thead>
      <tbody>
        {
          FORMULAS.map(([k, v]) => (
            <tr>
              <th scope="row">{k}</th>
              <td>{v}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="grid ai">
      <h3 class="h3 ai-title" id="ai-title">What is AI and what isn’t.</h3>
      <table class="table mono ai-table" aria-labelledby="ai-title">
        <thead>
          <tr><th scope="col" class="label">Uses a model</th><th scope="col" class="label">How</th></tr>
        </thead>
        <tbody>
          {
            AI_TABLE.map(([k, v]) => (
              <tr>
                <th scope="row">{k}</th>
                <td>{v}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <div class="not">
        <p class="label">No model involved</p>
        <ul class="mono">{NOT_AI.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: var(--s-8);
    row-gap: var(--s-3);
  }
  .intro .h2 {
    grid-column: 1 / span 7;
  }
  .intro .body {
    grid-column: 8 / span 5;
    align-self: end;
  }
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-14);
    line-height: 1.5;
  }
  .table th,
  .table td {
    text-align: left;
    vertical-align: baseline;
    padding: 0.9rem var(--gutter) 0.9rem 0;
    border-bottom: var(--hair);
    font-weight: 400;
  }
  .table thead th {
    padding-top: 0;
  }
  .table tbody th {
    width: 25%;
    color: var(--text);
    white-space: nowrap;
  }
  .table td {
    color: var(--text-dim);
  }
  .ai {
    margin-top: var(--s-12);
    row-gap: var(--s-4);
  }
  .ai-title {
    grid-column: 1 / -1;
  }
  .ai-table {
    grid-column: 1 / span 8;
  }
  .not {
    grid-column: 10 / span 3;
  }
  .not ul {
    margin-top: 0.9rem;
    font-size: var(--fs-14);
    color: var(--text-dim);
  }
  .not li {
    padding-block: 0.45rem;
    border-bottom: var(--hair);
  }
  @media (max-width: 900px) {
    .intro .h2,
    .intro .body,
    .ai-table,
    .not {
      grid-column: 1 / -1;
    }
    .table tbody th {
      white-space: normal;
      width: 38%;
    }
  }
</style>

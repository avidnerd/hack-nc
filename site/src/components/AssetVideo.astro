---
/**
 * A recording from the app, or, until it exists, a dark frame naming the
 * missing file. Never a stand-in that looks like footage.
 *
 * `name` is a basename in public/video. The first of these that exists wins:
 * <name>.webm (VP9, rendered by ../scripts/gesture-gifs.ts), <name>.mp4 (a
 * screen recording), <name>.gif.
 */
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

interface Props {
  name: string;
  caption: string;
  alt: string;
}
const { name, caption, alt } = Astro.props;
const dir = fileURLToPath(new URL('../../public/video/', import.meta.url));
const has = (ext: string) => existsSync(`${dir}${name}.${ext}`);
const video = has('webm') ? { ext: 'webm', type: 'video/webm' } : has('mp4') ? { ext: 'mp4', type: 'video/mp4' } : null;
const gif = !video && has('gif');
const poster = has('jpg') ? `/video/${name}.jpg` : undefined;
---

<figure class="asset">
  {
    video ? (
      <video
        muted
        playsinline
        loop
        preload="metadata"
        aria-label={alt}
        data-autoplay
        poster={poster}
        width="960"
        height="600"
      >
        <source src={`/video/${name}.${video.ext}`} type={video.type} />
      </video>
    ) : gif ? (
      <img src={`/video/${name}.gif`} alt={alt} loading="lazy" decoding="async" width="960" height="600" />
    ) : (
      <div class="pending" role="img" aria-label={`Recording not yet available: ${name}`}>
        <span class="label">Asset pending: {name}.webm</span>
      </div>
    )
  }
  <figcaption class="label">{caption}</figcaption>
</figure>

<style>
  .asset {
    display: grid;
    gap: var(--s-2);
  }
  video,
  img,
  .pending {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    background: var(--frame);
    border: var(--hair);
    border-radius: var(--radius);
    object-fit: cover;
  }
  .pending {
    display: grid;
    place-items: center;
  }
</style>

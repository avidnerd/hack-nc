---
import { LINKS, SOURCES, TEAM } from '../data/content.ts';
import Wordmark from './Wordmark.astro';
---

<footer class="footer">
  <div class="wrap grid">
    <div class="id">
      <Wordmark />
      <p>A research prototype built at HackNC 2026. Not a medical device.</p>
      {TEAM.length > 0 && <p>{TEAM.join(' · ')}</p>}
      <p class="links">
        {LINKS.github && <a href={LINKS.github}>GitHub</a>}
        {LINKS.devpost && <a href={LINKS.devpost}>Devpost</a>}
        <a href="/demo">Try it</a>
      </p>
    </div>
    <div class="data">
      <p class="label">Data</p>
      <p>CT and liver/tumour labels: Medical Segmentation Decathlon, Task03 Liver, CC BY-SA 4.0.</p>
      <p>Vessel, kidney and aorta labels: TotalSegmentator, CC BY 4.0.</p>
      <p>
        Glove in the gesture clips: based on
        <a href="https://sketchfab.com/3d-models/realistic-surgical-glove-with-folds-texture-38ab320219b647b19c77dfbc66c6e43a">Realistic Surgical Glove with Folds Texture</a>
        by <a href="https://sketchfab.com/jingfuchen">Jingfu Chen</a>, CC BY 4.0. Rigged by us.
      </p>
    </div>
    <div class="refs">
      <p class="label">References</p>
      <ol>
        {
          SOURCES.map((s) => (
            <li id={`ref-${s.id}`}>
              <span>{s.id}.</span>
              {s.href ? <a href={s.href}>{s.text}</a> : <span>{s.text}</span>}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--hair);
    padding-block: var(--s-12) var(--s-8);
    font-size: var(--fs-14);
    line-height: 1.6;
    color: var(--text-faint);
  }
  .footer .grid {
    row-gap: var(--s-6);
  }
  .id,
  .data,
  .refs {
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }
  .id {
    grid-column: 1 / span 3;
  }
  .data {
    grid-column: 4 / span 3;
  }
  .refs {
    grid-column: 7 / span 6;
  }
  .links {
    display: flex;
    gap: var(--s-3);
  }
  a {
    color: var(--text-dim);
  }
  ol {
    display: grid;
    gap: var(--s-1);
  }
  li {
    display: grid;
    grid-template-columns: 4ch 1fr;
  }
  @media (max-width: 900px) {
    .id,
    .data,
    .refs {
      grid-column: 1 / -1;
    }
  }
</style>

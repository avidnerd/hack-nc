# Copy to .env.local and fill in. Every one of these is optional:
# the app runs fully without them (regex intents + template sentences + browser TTS).

# "off" disables all LLM calls and forces regex intents / template narration.
VITE_LLM=gemini

VITE_GEMINI_KEY=
VITE_ANTHROPIC_KEY=

# Optional nicer TTS. Falls back to window.speechSynthesis when empty.
VITE_ELEVENLABS_KEY=

# Head-coupled perspective (M8). Costs a few fps; off by default.
VITE_HEAD=0

# ---------------------------------------------------------------- v2 backend
# Read by backend/ from .env (gitignored). Never prefix these with VITE_:
# anything VITE_* is compiled into the browser bundle.
NEBIUS_TF_API_KEY=
NEBIUS_TF_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Fill from GET /v1/models (docs/PLATFORM_NOTES.md); never guessed.
NEBIUS_TF_MODEL_SUPER=
TAVILY_API_KEY=
HF_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173

# Uploaded scans: the vista3d-full job runs in this project (eu-north1, H100)
VISTA_JOB_PROJECT_ID=
NEBIUS_S3_ENDPOINT=
NEBIUS_S3_BUCKET=
NEBIUS_S3_BUCKET_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
